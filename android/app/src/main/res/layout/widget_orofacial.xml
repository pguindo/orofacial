<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x2: mensaje único arriba, personaje grande anclado abajo.
     Solo vistas garantizadas en RemoteViews (LinearLayout, RelativeLayout,
     TextView, ImageView): sin espaciadores View, que algunos launchers rechazan.
     La raíz es transparente: su padding es el margen que se ve al estirarse. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_desc"
            android:textColor="#083344"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/widget_mood"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/widget_name"
            android:src="@drawable/ic_mood_contento" />

    </RelativeLayout>
</LinearLayout>
