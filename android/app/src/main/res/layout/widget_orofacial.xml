<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x2: tarjeta blanca de mensajes arriba, hueco transparente en medio,
     tarjeta marrón con el personaje abajo. Alturas proporcionales por peso
     (268/56/188) para que el diseño escale si el launcher estira el widget.
     Solo vistas garantizadas en RemoteViews. La raíz es transparente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="268"
        android:background="@drawable/widget_card_top"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:padding="10dp"
        android:text="@string/widget_desc"
        android:textColor="#4E342E"
        android:textSize="15sp" />

    <!-- Hueco transparente entre tarjetas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="56"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="188"
        android:background="@drawable/widget_card_bottom"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_mood"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mood_contento" />

    </LinearLayout>
</LinearLayout>
